{
  "name": "voicenote",
  "version": "1.0.0",
  "description": "Fully offline, privacy-first mobile app that converts speech to text and rewrites it into a chosen tone.",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "macos": "react-native run-macos",
    "start:macos": "react-native start",
    "bundle:macos": "react-native bundle --platform macos --dev false --entry-file index.js --bundle-output macos/voicenote-macOS/main.jsbundle --assets-dest macos/voicenote-macOS",
    "test": "jest --passWithNoTests --watchman=false --forceExit",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "audit:privacy": "node scripts/privacy-audit.js",
    "postinstall": "node scripts/patch-react-native-macos.js"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.14.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-keychain": "^8.2.0",
    "react-native-macos": "^0.76.12",
    "react-native-mmkv": "^2.12.2",
    "react-native-nitro-modules": "^0.18.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^3.35.0",
    "react-native-share": "^10.2.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-apple": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/metro-config": "^0.76.9",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-native": "^0.73.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "node-libs-react-native": "^1.2.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
